on start
{
//****************************************************************************
// Initialization of global variables
//****************************************************************************
	wrdRotKnobValue	= 0;
	intRotKnobMem	= 0;
	intKey7Mem  	= kNoStress;

	writeClear(0); // Clears the content of write window's system tab
  writeClear(1); // Clears the content of write window's system tab
  write ("***********************************************");
  write ("*   Training Network Simulation CANister      *");
  write ("*   ------------------------------------      *");
  write ("*                                             *");
  write ("*   Created by PTR for Training purposes      *");
  write ("*   Copyright 2012 Vector Informatik GmbH     *");
  write ("***********************************************");

	setTimerCyclic (tmrMsgStatus, 200);
	setTimerCyclic (tmrLEDStatus, 500);
  setTimerCyclic (tmrMsgStatAB, 100);
  setTimerCyclic (tmrMsgString, 200);
  setTimerCyclic (tmrMsgMux,   1000);
  setTimerCyclic (tmrMsgIdent, 2000);

	@sysvar::CANister::sysLED17 = 1;

// Configuration of Write Window Outupt
#if CANOE
    setWriteDbgLevel (0); // Only write statements with Priority 0 will be output
#endif 
}

on timer tmrLEDStatus
{
//****************************************************************************
// This timer is used to toggle the Status LED of CANister
//****************************************************************************
	
	byte bytToggle;

	sysSetVariableInt(sysvar::CANister::sysLEDStatus, bytToggle); 
	bytToggle =! bytToggle;
}

on timer tmrMsgStatus
{
//****************************************************************************
// Cyclic sending of CANister's status message
//****************************************************************************	
        	
	msgStatus.DLC=4;
	msgStatus.byte(0) = bytCounter++;
	msgStatus.word(1) = swapWord(wrdRotKnobValue);
	msgStatus.byte(3) = fctKeyState();

// Tx Communication has been disabled by diagnostics request
    if (intComEnabled == kDISABLED) 
        return;
        	
	output (msgStatus);
}

byte fctKeyState (void)
{
//*****************************************************************************
// This function determines the pressed keys. To put the value of key in the
// right position there is a need for moving the corresponding key bit inside
// of the State-variable. To avoid overwriting each step is saved by using an
// OR-command. Finally the actual state of the keys is returned
//*****************************************************************************	
	
	bytKeyState=0;

	bytKeyState=bytKeyState|sysGetVariableInt(sysvar::CANister::sysKey1);
	bytKeyState=bytKeyState|sysGetVariableInt(sysvar::CANister::sysKey2)<<1;
	bytKeyState=bytKeyState|sysGetVariableInt(sysvar::CANister::sysKey3)<<2;
	bytKeyState=bytKeyState|sysGetVariableInt(sysvar::CANister::sysKey4)<<3;
	bytKeyState=bytKeyState|sysGetVariableInt(sysvar::CANister::sysKey5)<<4;
	bytKeyState=bytKeyState|sysGetVariableInt(sysvar::CANister::sysKey6)<<5;
	bytKeyState=bytKeyState|sysGetVariableInt(sysvar::CANister::sysKey7)<<6;
	bytKeyState=bytKeyState|sysGetVariableInt(sysvar::CANister::sysKey8)<<7;

	return bytKeyState;
}

on timer tmrRotKnobDelay
{
//****************************************************************************
// Within this on timer event the value of the Rotary Knob signal is 
// incremented or decremented, depending on the pushed button on the panel.
// The first if-command checks whether the value of the Rotary Knob is
// in-between 0 and 1023.
//****************************************************************************
int i;
	if (wrdRotKnobValue >=0 && wrdRotKnobValue<=1023)
	{
		switch (fctRotKnobState())
		{	
			
			//KeyMin pushed
			case 1: if (wrdRotKnobValue<=1)
						wrdRotKnobValue=0;
					else
						wrdRotKnobValue-=1; 
					setTimer(tmrRotKnobDelay, 200);
					break;
			
			//KeyMinMin pushed
			case 2: if (wrdRotKnobValue<10)
						wrdRotKnobValue=0;
					else
						wrdRotKnobValue-=10; 
					setTimer(tmrRotKnobDelay, 200);
					break;

			//KeyMax pushed
			case 4: if (wrdRotKnobValue>=1022)
						wrdRotKnobValue=0x3ff;
					else
						wrdRotKnobValue+=1;
					setTimer(tmrRotKnobDelay, 200);
					break;
			
			//KeyMaxMax pushed
			case 8: if (wrdRotKnobValue>1013)
						wrdRotKnobValue=0x3ff;
					else
						wrdRotKnobValue+=10;
					setTimer(tmrRotKnobDelay, 200);
					break;
			
			default: cancelTimer(tmrRotKnobDelay);
		}
	}
}

byte fctRotKnobState (void)
{
//*****************************************************************************
// This function determines which of the Keys to change the value of the Rotary
// Knob has been pushed. Depending on the Key, the value of the Rotary Knob
// will be increased or decreased (see event tmrRotKnobDelay).
//*****************************************************************************	

	byte bytRotKnobState;

	bytRotKnobState=0;

	bytRotKnobState=bytRotKnobState|sysGetVariableInt(sysvar::CANister::sysKeyMin);
	bytRotKnobState=bytRotKnobState|sysGetVariableInt(sysvar::CANister::sysKeyMinMin)<<1;
	bytRotKnobState=bytRotKnobState|sysGetVariableInt(sysvar::CANister::sysKeyMax)<<2;
	bytRotKnobState=bytRotKnobState|sysGetVariableInt(sysvar::CANister::sysKeyMaxMax)<<3;

	return bytRotKnobState;

}

on sysvar sysvar::CANister::sysKeyMax
{
//****************************************************************************
// The if-command checks whether the Key has been pressed or released, because 
// this event is called in both cases. If the key has been pressed, the timer
// to calculate the Rotary Knob Value is set.
//****************************************************************************	
	
	if (sysGetVariableInt(sysvar::CANister::sysKeyMax) == 1 && intRotKnobMem == kRotKnobTimerStopped)
	{
		setTimer(tmrRotKnobDelay, 10);
		intRotKnobMem = kRotKnobTimerRunning;			
	}

	else if (sysGetVariableInt(sysvar::CANister::sysKeyMax) == 0 && intRotKnobMem == kRotKnobTimerRunning)
		intRotKnobMem = kRotKnobTimerStopped;

}

on sysvar sysvar::CANister::sysKeyMin
{
//****************************************************************************
// The if-command checks whether the Key has been pressed or released, because 
// this event is called in both cases. If the key has been pressed, the timer
// to calculate the Rotary Knob Value is set.
//****************************************************************************	
	
	if (sysGetVariableInt(sysvar::CANister::sysKeyMin) == 1 && intRotKnobMem == kRotKnobTimerStopped)
	{
		setTimer(tmrRotKnobDelay, 10);
		intRotKnobMem = kRotKnobTimerRunning;			
	}

	else if (sysGetVariableInt(sysvar::CANister::sysKeyMin)==0 && intRotKnobMem == kRotKnobTimerRunning)
		intRotKnobMem = kRotKnobTimerStopped;

}

