{
//****************************************************************************
// Diag Request to read Environment Data corresponding to a specific DTC
//****************************************************************************  
    diagResponse this rspReadEnvData;
    dword dwrdDTC;
    long lngReturn;
    
    dwrdDTC = diagGetParameter (this, "DTC"); 

    //diagResize (rspReadEnvData, 12);
    diagSetParameter (rspReadEnvData, "DTC", dwrdDTC);
    diagSetParameter (rspReadEnvData, "DtcStatusbyte", 0x09);

    //diagSetComplexParameter (rspReadEnvData,"ListOfDTC", 0, "envLEDs", bytLED_EnvDTC [dwrdDTC] );
    //diagSetComplexParameter (rspReadEnvData,"ListOfDTC", 0, "envZaehler", bytSigCounter_EnvDTC[dwrdDTC]);
    //diagSetComplexParameter (rspReadEnvData,"ListOfDTC", 0, "envDrehregler", wrdSigRotKnob_EnvDTC[dwrdDTC]);

    lngReturn = diagSendResponse (rspReadEnvData);
    //write ("%d", lngReturn);
}

fctDiagSaveEnvDataDTC (int intDTC)
{
//****************************************************************************
// Function to save environment Data when DTC is written into fault memory
//**************************************************************************** 

    intDTC--;

    bytLED_EnvDTC [intDTC] = fctLEDState1 (); 

    bytSigCounter_EnvDTC [intDTC] = bytCounter;
    
    wrdSigRotKnob_EnvDTC [intDTC] = wrdRotKnobValue;
    
}

