	diagSetParameter (rspDevelopData, "CanDriverVersion", dblCanDriver);
    diagSetParameter (rspDevelopData, "CANister_Config_Version", dblConfigVer);
	diagSetParameter (rspDevelopData, "DiagnosticModuleVersion", dblDiagModule);
	diagSetParameter (rspDevelopData, "OperatingSystemVersion", dblOSVer);
	diagSetParameter (rspDevelopData, "TransportLayerVersion", dblTPVer);
	diagSendResponse (rspDevelopData);

    fctDiagStayInActiveSession ();
}

