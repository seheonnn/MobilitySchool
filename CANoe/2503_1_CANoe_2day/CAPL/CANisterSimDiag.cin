variables
{
  msTimer tmrSecureTimer; // Diagnostics: Programming Session Timeout
  msTimer tmrCntRoutine;
  msTimer tmrHardReset;
  msTimer tmrErrorFrame;

}

on diagRequest SerialNumber_Read
{
//****************************************************************************
// Diag Request to read out CANsiter's serial number
//****************************************************************************
    diagResponse this respSerialRead;

    diagSetParameter (respSerialRead, "SerialNumber", dblSerialNumber);

    diagSendPositiveResponse (respSerialRead);

    fctDiagStayInActiveSession ();
}

on diagRequest *
{
//****************************************************************************
// Negative response to all diag requests that are not supported
//****************************************************************************
    diagResponse this respAll;

    diagSendNegativeResponse (respAll, 0x10); // General rejection

    fctDiagStayInActiveSession ();
}

