<ATTRCAT id='_0D2FC5C8' oid='FB0411BC5D2641ff9AE0F2788992D914'>
<NAME>
<TUV xml:lang='en-US'>CANdesc</TUV>
<TUV xml:lang='de-DE'>CANdesc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Information used by CANdelaGen to configure diagnostic software components.</TUV>
<TUV xml:lang='de-DE'>Von CANdelaGen benötigte Information um Diagnose-Softwarekomponenten zu konfigurieren.</TUV>
</DESC>
<QUAL>CANdesc</QUAL>
</ATTRCAT>
<ATTRCAT id='_0D2FC810' oid='5B651F6B353F467085D76AF0182CEC5C'>
<NAME>
<TUV xml:lang='en-US'>Any attribute category</TUV>
<TUV xml:lang='de-DE'>Irgendeine Attributkategorie</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Example of a user-defined attribute category and its usage in CANdelaStudio documents.</TUV>
<TUV xml:lang='de-DE'>Beispiel für eine benutzerdefinierte Attributkategorie und deren Verwendung in CANelaStudio-Dokumenten.</TUV>
</DESC>
<QUAL>AnyAttributeCategory</QUAL>
</ATTRCAT>
