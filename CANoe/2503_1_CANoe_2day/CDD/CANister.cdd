</DATAOBJATTS>
<DIAGCLASSATTS>
<ENUMDEF id='_0D302F30' oid='02854FAF7CF44ddcBEF00466546F011D' attrcatref='_0D2FC5C8' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>MainHandlerSupport (on Protocol Service Level)</TUV>
<TUV xml:lang='de-DE'>MainHandlerSupport (auf Protokollservice-Level)</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Provide MainHandlers and select type for all protocol services of the diagnostic class.</TUV>
<TUV xml:lang='de-DE'>MainHandler und Auswahltyp für alle Protokollservices der Diagnoseklasse bereitstellen.</TUV>
</DESC>
<QUAL>MainHandlerSupport</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>none</TUV>
<TUV xml:lang='de-DE'>kein</TUV>
</ETAG>
